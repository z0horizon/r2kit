# ══════════════════════════════════════════════════
# Rust (github/gitignore/Rust.gitignore)
# ══════════════════════════════════════════════════

# Compiled files and executables
debug/
target/

# Backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these
*.pdb

# Generated by cargo-mutants
**/mutants.out*/

# rustc internal compiler error dumps
rustc-ice-*.txt

# Cargo.lock — ignored for libraries per Cargo guidelines:
# https://doc.rust-lang.org/cargo/faq.html#why-have-cargolock-in-version-control
Cargo.lock

# ══════════════════════════════════════════════════
# Environment / Secrets
# ══════════════════════════════════════════════════
.env
.env.*

# ══════════════════════════════════════════════════
# Coverage / Profiling
# ══════════════════════════════════════════════════
*.profraw
*.profdata
lcov.info
tarpaulin-report.html
coverage/

# ══════════════════════════════════════════════════
# macOS (github/gitignore/Global/macOS.gitignore)
# ══════════════════════════════════════════════════
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
__MACOSX/

# Files that might appear in the root of a volume
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Directories potentially created on remote AFP share
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# ══════════════════════════════════════════════════
# Linux (github/gitignore/Global/Linux.gitignore)
# ══════════════════════════════════════════════════
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# ══════════════════════════════════════════════════
# Windows (github/gitignore/Global/Windows.gitignore)
# ══════════════════════════════════════════════════
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# ══════════════════════════════════════════════════
# Editors / IDEs
# ══════════════════════════════════════════════════

# VS Code (github/gitignore/Global/VisualStudioCode.gitignore)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets
*.code-workspace

# JetBrains (RustRover, IntelliJ, CLion, etc.)
.idea/

# Vim / Neovim
*.swp
*.swo
[._]*.s[a-v][a-z]
[._]*.un~
Session.vim
Sessionx.vim
.netrwhist
tags

# ══════════════════════════════════════════════════
# Local Agent Workflows / Scratch
# ══════════════════════════════════════════════════
.agents/
skills-lock.json
.scratch/
.handoff/
*HANDOFF*.md

